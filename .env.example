# App
APP_ENV=development
APP_NAME=blood-donation-api
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
TIMEZONE=UTC

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/blood_donation

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OTP
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMS provider adapter
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT_SECONDS=10
SMS_MAX_RETRIES=3

# Maps provider adapter
MAPS_PROVIDER=mock
MAPS_API_KEY=
MAPS_TIMEOUT_SECONDS=8

# Dispatch
DISPATCH_BATCH_SIZE=5
DISPATCH_RESPONSE_WINDOW_MINUTES=15
DISPATCH_MAX_CANDIDATES=100

# CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Additions agreed in docs/decisions/0002-adapters-and-config.md ---
# Rate limiting for the public OTP endpoints (section 9.1 requires per-phone and per-IP limits).
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_MAX_REQUESTS_PER_IP=15

# Section 11.3 step 5: automatic dispatch stays disabled until an authorised
# compatibility source exists. `demo` runs label-only matching on fake data.
COMPATIBILITY_POLICY=demo

# Absolute base URL used to build the secure donor response link in SMS templates.
PUBLIC_APP_BASE_URL=http://localhost:5500

# Demo mailbox for the mock provider (development only, gitignored): lets the team read
# an OTP code or a dispatch link without putting either in a log. Must stay empty in production.
SMS_DEV_OUTBOX_FILE=.dev-outbox.log
